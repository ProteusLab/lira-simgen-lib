{%- if width == 128 -%}
  if (a == 0) return 128;
  uint64_t hi = (uint64_t)(a >> 64);
  if (hi) return clz_64(hi);
  else return 64 + clz_64((uint64_t)a);
{%- else -%}
  if (a == 0) return {{ width }};
  unsigned n = 0;
  while ((a & {{ "0x80" if width == 8 else "0x8000" if width == 16 else "0x80000000" if width == 32 else "0x8000000000000000ULL" }}) == 0) {
    a <<= 1;
    n++;
  }
  return n;
{%- endif -%}

  { {{ node.shift }}, {{ node.mask }}, {{ node.offset }} },
{%- endfor %}
};

constexpr std::array<std::size_t, {{ tree.children|length }}> children = {
{%- for child in tree.children %}
  {{ child }},
{%- endfor %}
};

using LeafFunction = std::optional<prot::isa::Instruction> (*)(prot::isa::Word);

constexpr LeafFunction leaves[] = {
{%- for candidates in tree.leaf_candidates %}
  decode_leaf_{{ loop.index0 }},
{%- endfor %}
};


std::optional<prot::isa::Instruction> decode(const prot::isa::Word {{ word_arg }}) {
  auto index = std::size_t{ {{ tree.root_index }} };
  while (nodes[index].mask != 0) {
    const auto& node = nodes[index];
    index = children[node.offset + (({{ word_arg }} >> node.shift) & node.mask)];
  }
  return leaves[nodes[index].offset]({{ word_arg }});
}
